# Copy to .env.local (never commit real values). In production the server
# lists anything still missing in its log at startup (src/server/env-check.ts).

# ── Site ────────────────────────────────────────────────────────────────────
# Public address, printed into every QR code: set it once, never change it.
APP_URL=
# NEXT_PUBLIC_BRAND_NAME=Tapmore
# Shown on the help page, policies and emails. Read at build time: rebuild after changing.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Comma-separated super admins (the email must be verified).
ADMIN_EMAILS=

# ── Business details (legal pages, Contact page, Razorpay activation) ──────
# The business that runs Tapmore (shown only in legal fine print, never as branding):
#   a partnership firm:  LEGAL_ENTITY_NAME=Tapmore  LEGAL_ENTITY_TYPE=a partnership firm
#   a proprietor:        LEGAL_ENTITY_NAME=Your Name, trading as Tapmore
#   a company:           LEGAL_ENTITY_NAME=Tapmore Technologies Private Limited
LEGAL_ENTITY_NAME=
# LEGAL_ENTITY_TYPE=a partnership firm
# LEGAL_REGISTRATION=Udyam UDYAM-MH-00-0000000   # or firm registration no., CIN, LLPIN
# Full registered address with PIN code.
LEGAL_ADDRESS=
# City whose courts hear disputes, e.g. Pune.
LEGAL_JURISDICTION_CITY=
SUPPORT_PHONE=
# SUPPORT_HOURS=Monday to Saturday, 10 am to 6 pm IST
# The person complaints go to, named on the Contact and privacy pages (can be a partner).
GRIEVANCE_OFFICER_NAME=
# GRIEVANCE_OFFICER_EMAIL=   # defaults to NEXT_PUBLIC_SUPPORT_EMAIL
# Only once registered for GST (you can't charge GST without it); then also set
# CHARGES_GST = true in src/lib/plans.ts and update the Razorpay plan amount.
# GSTIN=

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL. Leave empty locally to use the embedded database in ./data/pg.
# Supabase on Vercel (or any serverless host): Project → Connect → Transaction pooler
# string (port 6543), with your password. On a single server, the Session pooler (5432).
DATABASE_URL=
# Check the server's certificate: the CA as PEM text or a file path
# (Supabase: Project Settings → Database → SSL Configuration → Download certificate).
# DATABASE_SSL_CA=
# DATABASE_SSL=verify     # instead, for a certificate a public CA signed
# DATABASE_SSL=off        # only for a self-hosted server without TLS
# DATABASE_POOL_SIZE=5

# ── Files ───────────────────────────────────────────────────────────────────
# Images and feedback photos in an S3-compatible bucket (Supabase Storage, MinIO, R2, AWS).
# Leave empty to keep them on this server's disk under ./data.
# Supabase: Storage → Settings → S3 access keys; endpoint https://<project>.supabase.co/storage/v1/s3
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# DATA_DIR=./data

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
# An address on your verified sending domain, e.g. Tapmore <hello@tapmore.in>
MAIL_FROM=

# ── Payments (Razorpay) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# BILLING_DEV_MODE=1      # staging only: "Subscribe" switches a venue on without paying

# ── Bot protection (Cloudflare Turnstile) on sign-up and password reset ────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Rate limits: where the visitor's address comes from ────────────────────
# Proxies in front of the app (1: the host's load balancer; 2 with Cloudflare in front).
# TRUSTED_PROXY_COUNT=1
# Or a header your CDN sets itself, e.g. cf-connecting-ip.
# CLIENT_IP_HEADER=

# ── Background jobs ─────────────────────────────────────────────────────────
# DISABLE_JOBS=1          # run them from an external scheduler instead…
# CRON_SECRET=            # …which calls POST /api/cron/run with "Authorization: Bearer <secret>"

# ── AI menu import and dish notes ───────────────────────────────────────────
GROQ_API_KEY=
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=groq

# ── Google review replies (Google Business Profile) ─────────────────────────
# Tapmore's own OAuth client (Google Cloud → Google Auth Platform → Clients,
# a Web application with redirect URI <APP_URL>/api/google/callback). Café
# owners only ever tap "Connect Google"; they never see these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Seals each café's Google refresh token in the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never change it once cafés have connected (their tokens would stop opening).
TOKEN_ENCRYPTION_KEY=
# New-review alerts within minutes (Pub/Sub topic with a push subscription to
# <APP_URL>/api/google/notifications?token=<GOOGLE_PUSH_TOKEN>). Without them
# a daily check still finds new reviews.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUSH_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
# GOOGLE_NL_API_KEY=      # sentiment of feedback notes (a built-in word list otherwise)

# ── Monitoring ──────────────────────────────────────────────────────────────
# Error reports and traces (server only; nothing is added to guest pages).
# Sentry → Project settings → Client keys (DSN). Off when empty.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1   # share of requests traced; errors are always sent
# Real-world page speed needs no setting: on Vercel, turn on Speed Insights for the project.
